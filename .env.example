# ============================================================
# Drawlatch — Environment Variables
# ============================================================
# Append the lines you need to ~/.drawlatch/.env and fill in the
# values. Don't copy this file over it: that would erase the
# dashboard password hash (AUTH_PASSWORD_HASH/SALT) stored there.
# Only connections listed in a caller's "connections" array
# need values.
#
# Secrets are per caller: prefix each name with the caller alias,
# uppercased with "-" replaced by "_". The names below are for
# the caller "default"; for caller "my-agent" use
# MY_AGENT_GITHUB_TOKEN, etc. Unprefixed names (GITHUB_TOKEN)
# are never read. Restart the daemon after editing this file.
# ============================================================

# ------------------------------------------------------------
# Logging
# Log level for server output (error, warn, info, debug).
# Default: info
# ------------------------------------------------------------
LOG_LEVEL=info

# ------------------------------------------------------------
# AgentMail API
# https://docs.agentmail.to/api-reference
# Connection: "agentmail"
# ------------------------------------------------------------
DEFAULT_AGENTMAIL_API_KEY=

# ------------------------------------------------------------
# Anthropic Claude API
# https://docs.anthropic.com/en/api
# Connection: "anthropic"
# ------------------------------------------------------------
DEFAULT_ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Bluesky API (AT Protocol)
# https://docs.bsky.app/
# Connection: "bluesky"
# ------------------------------------------------------------
DEFAULT_BLUESKY_ACCESS_TOKEN=

# ------------------------------------------------------------
# Datadog API
# https://docs.datadoghq.com/api/latest/
# Connection: "datadog"
# ------------------------------------------------------------
DEFAULT_DATADOG_API_KEY=
DEFAULT_DATADOG_APP_KEY=

# ------------------------------------------------------------
# Devin AI API
# https://docs.devin.ai/api-reference/overview
# Connection: "devin"
# ------------------------------------------------------------
DEFAULT_DEVIN_API_KEY=

# ------------------------------------------------------------
# Discord Bot API
# https://discord.com/developers/docs/intro
# Connection: "discord-bot"
# ------------------------------------------------------------
DEFAULT_DISCORD_BOT_TOKEN=

# ------------------------------------------------------------
# Discord OAuth2 API
# https://discord.com/developers/docs/topics/oauth2
# Connection: "discord-oauth"
# ------------------------------------------------------------
DEFAULT_DISCORD_OAUTH_TOKEN=

# ------------------------------------------------------------
# Exa Search API
# https://docs.exa.ai/reference/getting-started
# Connection: "exa"
# ------------------------------------------------------------
DEFAULT_EXA_API_KEY=

# ------------------------------------------------------------
# Firecrawl API
# https://docs.firecrawl.dev/api-reference/introduction
# Connection: "firecrawl"
# ------------------------------------------------------------
DEFAULT_FIRECRAWL_API_KEY=

# ------------------------------------------------------------
# GitHub REST API
# https://docs.github.com/en/rest
# Connection: "github"
# ------------------------------------------------------------
DEFAULT_GITHUB_TOKEN=
# Optional — webhook ingestor: signing secret for incoming GitHub webhooks
DEFAULT_GITHUB_WEBHOOK_SECRET=
# Optional — webhook ingestor: public URL GitHub delivers webhooks to
DEFAULT_GITHUB_WEBHOOK_URL=

# ------------------------------------------------------------
# Google AI (Gemini) API
# https://ai.google.dev/api
# Connection: "google-ai"
# ------------------------------------------------------------
DEFAULT_GOOGLE_AI_API_KEY=

# ------------------------------------------------------------
# Google APIs (Sheets, Docs, Drive, Calendar, Gmail, etc.)
# https://developers.google.com/apis-explorer
# Connection: "google"
# ------------------------------------------------------------
DEFAULT_GOOGLE_API_TOKEN=

# ------------------------------------------------------------
# Hex API
# https://learn.hex.tech/docs/api/api-overview
# Connection: "hex"
# ------------------------------------------------------------
DEFAULT_HEX_TOKEN=

# ------------------------------------------------------------
# Lichess API
# https://lichess.org/api
# Connection: "lichess"
# ------------------------------------------------------------
DEFAULT_LICHESS_API_TOKEN=

# ------------------------------------------------------------
# Linear GraphQL API
# https://developers.linear.app/docs/graphql/working-with-the-graphql-api
# Connection: "linear"
# ------------------------------------------------------------
DEFAULT_LINEAR_API_KEY=

# ------------------------------------------------------------
# Mastodon API
# https://docs.joinmastodon.org/api/
# Connection: "mastodon"
# ------------------------------------------------------------
DEFAULT_MASTODON_ACCESS_TOKEN=

# ------------------------------------------------------------
# Notion API
# https://developers.notion.com/reference
# Connection: "notion"
# ------------------------------------------------------------
DEFAULT_NOTION_API_KEY=

# ------------------------------------------------------------
# OpenAI API
# https://platform.openai.com/docs/api-reference
# Connection: "openai"
# ------------------------------------------------------------
DEFAULT_OPENAI_API_KEY=

# ------------------------------------------------------------
# OpenRouter API
# https://openrouter.ai/docs/api-reference
# Connection: "openrouter"
# ------------------------------------------------------------
DEFAULT_OPENROUTER_API_KEY=

# ------------------------------------------------------------
# Parallel API
# https://docs.parallel.ai/api-reference/search/search
# Connection: "parallel"
# ------------------------------------------------------------
DEFAULT_PARALLEL_API_KEY=

# ------------------------------------------------------------
# Perplexity API
# https://docs.perplexity.ai/api-reference
# Connection: "perplexity"
# ------------------------------------------------------------
DEFAULT_PERPLEXITY_API_KEY=

# ------------------------------------------------------------
# Reddit API
# https://www.reddit.com/dev/api/
# Connection: "reddit"
# ------------------------------------------------------------
DEFAULT_REDDIT_ACCESS_TOKEN=
DEFAULT_REDDIT_USER_AGENT=
# Optional — poll ingestor: subreddit to watch for new posts
DEFAULT_REDDIT_SUBREDDIT=

# ------------------------------------------------------------
# Slack Web API
# https://docs.slack.dev/apis/web-api
# Connection: "slack"
# ------------------------------------------------------------
# Optional — Socket Mode ingestor: app-level token for real-time events
DEFAULT_SLACK_APP_TOKEN=
DEFAULT_SLACK_BOT_TOKEN=

# ------------------------------------------------------------
# Stripe Payments API
# https://docs.stripe.com/api
# Connection: "stripe"
# ------------------------------------------------------------
DEFAULT_STRIPE_SECRET_KEY=
# Optional — webhook ingestor: signing secret for incoming Stripe webhooks
DEFAULT_STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------
# Telegram Bot API
# https://core.telegram.org/bots/api
# Connection: "telegram"
# ------------------------------------------------------------
DEFAULT_TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------
# Trello API
# https://developer.atlassian.com/cloud/trello/rest/
# Connection: "trello"
# ------------------------------------------------------------
DEFAULT_TRELLO_API_KEY=
DEFAULT_TRELLO_TOKEN=
# Optional — webhook ingestor: API secret used to verify Trello webhook signatures
DEFAULT_TRELLO_API_SECRET=
# Optional — webhook ingestor: public URL Trello delivers webhooks to
DEFAULT_TRELLO_CALLBACK_URL=

# ------------------------------------------------------------
# Twitch API
# https://dev.twitch.tv/docs/api/reference/
# Connection: "twitch"
# ------------------------------------------------------------
DEFAULT_TWITCH_ACCESS_TOKEN=
DEFAULT_TWITCH_CLIENT_ID=
# Optional — poll ingestor: user ID whose followed streams are polled
DEFAULT_TWITCH_USER_ID=

# ------------------------------------------------------------
# X (Twitter) API
# https://developer.x.com/en/docs/x-api
# Connection: "x"
# ------------------------------------------------------------
DEFAULT_X_BEARER_TOKEN=
# Optional — poll ingestor: recent-search query to poll
DEFAULT_X_SEARCH_QUERY=
